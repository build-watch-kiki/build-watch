BACKEND_VERSION=1.0.7
CV_VERSION=1.0.2
FRONTEND_VERSION=1.0.6

RUN__PORT=8000
FRONTEND_PORT=3000
API_BASE_URL=/api/
BACKEND_URL=http://build-watch-backend:8000
FRONTEND_ALLOWED_HOSTS=

# Broker (RabbitMQ)
BROKER__HOST=rabbitmq
BROKER__PORT=5672
BROKER__USERNAME=guest
BROKER__PASSWORD=change_me
BROKER__QUEUE__NEW_PHOTO=new-photo

# Database (Postgres)
DB__HOST=postgres
DB__PORT=5432
DB__NAME=build-watch-db
DB__USER=postgres
DB__PASSWORD=change_me

# S3/MinIO
S3__ENDPOINT=http://minio:9000
S3__ACCESS_KEY=minioadmin
S3__SECRET_KEY=change_me
S3__BUCKET=buildwatch
S3__MODEL_VERSION=v2

# Source S3 for copying pinned CV weights into local MinIO
MODEL_SOURCE_ENDPOINT=http://your-s3-endpoint:9000
MODEL_SOURCE_ACCESS_KEY=change_me
MODEL_SOURCE_SECRET_KEY=change_me
MODEL_SOURCE_BUCKET=buildwatch-cv

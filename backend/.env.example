RUN__PORT=8000
LOG__LEVEL=INFO

# Daily plan-fact analysis
ANALYSIS__TIMEZONE=Europe/Moscow
ANALYSIS__MIN_CONFIDENCE=0.50
ANALYSIS__MINIMUM_STAGE_SCORE=0.60
ANALYSIS__TRANSITION_MARGIN=0.10

# Mocks
USE_MOCK__STAGE_REPO=0

# Broker
BROKER__HOST=localhost
BROKER__PORT=5672
BROKER__USERNAME=guest
BROKER__PASSWORD=guest

BROKER__QUEUE__NEW_PHOTO=new-photo
BROKER__QUEUE__CV_RESULT=cv-result

# Database
DB__HOST=localhost
DB__PORT=5432
DB__NAME=hackaton-lct-dev
DB__USER=postgres
DB__PASSWORD=postgres

# S3/MinIO
S3__ENDPOINT=http://localhost:9000
S3__ACCESS_KEY=minioadmin
S3__SECRET_KEY=minioadmin
S3__BUCKET=app-bucket
